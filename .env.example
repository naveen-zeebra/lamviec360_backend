# ==============================================================================
# Multi-Gateway Job Portal Environment Configuration
# ==============================================================================

APP_ENV=local  # local | develop | production
APP_NAME=JobPortalMultiGateway

# ------------------------------------------------------------------------------
# Gateway Server Ports
# ------------------------------------------------------------------------------
JOBSEEKER_PORT=8001
COMPANY_PORT=8002
ADMIN_PORT=8003

# ------------------------------------------------------------------------------
# Database Configurations
# ------------------------------------------------------------------------------
# Choose engine: "sqlite" for zero-config file db, or "postgres" for PostgreSQL
DB_ENGINE=sqlite

# Standard PostgreSQL Credentials & Database Name (Basic Setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobportal_db

# Direct Connection URL (If set, takes precedence over discrete POSTGRES_* params)
DATABASE_URL=sqlite:///./jobportal.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobportal_db

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=super-secret-jwt-key-for-job-portal-platform-360
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# CORS Configuration (comma-separated origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# File Upload / Media Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# Seed & Initial Admin Credentials
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Password123!
