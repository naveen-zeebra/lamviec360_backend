# ==============================================================================
# Multi-Gateway Job Portal Environment Configuration
# ==============================================================================

APP_ENV=local  # local | develop | production
APP_NAME=JobPortalMultiGateway

# ------------------------------------------------------------------------------
# Gateway Server Ports
# ------------------------------------------------------------------------------
JOBSEEKER_PORT=8001
COMPANY_PORT=8002
ADMIN_PORT=8003

# ------------------------------------------------------------------------------
# Frontend Application URLs (Jobseeker, Company / Employer, Super Admin)
# ------------------------------------------------------------------------------
# 1) Local (Default)
JOBSEEKER_WEB_URL="http://localhost:3001"
COMPANY_WEB_URL="http://localhost:3002"
ADMIN_WEB_URL="http://localhost:3003"  # or http://localhost:5175

# 2) Develop (dev*.lamviec360.com)
# JOBSEEKER_WEB_URL="https://devjobseeker.lamviec360.com"
# COMPANY_WEB_URL="https://devcompany.lamviec360.com"
# ADMIN_WEB_URL="https://devsuperadmin.lamviec360.com"

# 3) Production (*.lamviec360.com)
# JOBSEEKER_WEB_URL="https://lamviec360.com"
# COMPANY_WEB_URL="https://company.lamviec360.com"
# ADMIN_WEB_URL="https://superadmin.lamviec360.com"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL DATABASE_URL only)
# ------------------------------------------------------------------------------
# Local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobportal_db
# Develop
# DATABASE_URL=postgresql://postgres:lv360_dev_password@103.175.146.37:5432/mockdb
# Production
# DATABASE_URL=postgresql://user:password@prod-host:5432/jobportal_prod

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=super-secret-jwt-key-for-job-portal-platform-360
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# CORS Configuration (comma-separated origins)
# ------------------------------------------------------------------------------
# Local
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5175,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Develop
# CORS_ORIGINS=https://devjobseeker.lamviec360.com,https://devcompany.lamviec360.com,https://devsuperadmin.lamviec360.com,https://devapi.lamviec360.com
# Production
# CORS_ORIGINS=https://lamviec360.com,https://company.lamviec360.com,https://superadmin.lamviec360.com,https://api.lamviec360.com

# ------------------------------------------------------------------------------
# File Upload / Media Storage Configurations (in Megabytes)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_AVATAR_SIZE_MB=2
MAX_RESUME_SIZE_MB=5
MAX_RESUMES_PER_SEEKER=5
MAX_CERTIFICATION_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10
MAX_DOCUMENT_QUOTA_MB=100
MAX_COMPANY_LOGO_MB=5
MAX_COMPANY_BANNER_MB=10

# ------------------------------------------------------------------------------
# Seed & Initial Admin Credentials
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# OAuth Identity Providers (Google, Zalo, LinkedIn, Facebook)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/oauth-callback?provider=google"
# Develop: GOOGLE_REDIRECT_URI="https://devjobseeker.lamviec360.com/oauth-callback?provider=google"
# Production: GOOGLE_REDIRECT_URI="https://lamviec360.com/oauth-callback?provider=google"

ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_REDIRECT_URI="http://localhost:3001/oauth-callback?provider=zalo"
# Develop: ZALO_REDIRECT_URI="https://devjobseeker.lamviec360.com/oauth-callback?provider=zalo"
# Production: ZALO_REDIRECT_URI="https://lamviec360.com/oauth-callback?provider=zalo"

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3001/oauth-callback?provider=linkedin"
# Develop: LINKEDIN_REDIRECT_URI="https://devjobseeker.lamviec360.com/oauth-callback?provider=linkedin"
# Production: LINKEDIN_REDIRECT_URI="https://lamviec360.com/oauth-callback?provider=linkedin"

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3001/oauth-callback?provider=facebook"
# Develop: FACEBOOK_REDIRECT_URI="https://devjobseeker.lamviec360.com/oauth-callback?provider=facebook"
# Production: FACEBOOK_REDIRECT_URI="https://lamviec360.com/oauth-callback?provider=facebook"

